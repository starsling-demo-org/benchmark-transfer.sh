  "adaptations": [
    {
      "id": "no-registry-login-or-push",
      "kind": "deployment-guard",
      "workflowFile": ".github/workflows/build-docker-images.yml",
      "jobId": "buildx",
      "fromPattern": "success() && github.event_name != 'pull_request'",
      "toReplacement": "false && success() && github.event_name != 'pull_request'",
      "expectedMatches": 2,
      "reason": "Docker Login and Docker Buildx (push) steps: DOCKER_USERNAME / DOCKER_PASSWORD do not exist and nothing may be published; upstream guard kept, 'false &&' in front",
      "blocksFullParity": true
    },
    {
      "id": "no-manifest-check-or-clear",
      "kind": "deployment-guard",
      "workflowFile": ".github/workflows/build-docker-images.yml",
      "jobId": "buildx",
      "fromPattern": "always() && github.event_name != 'pull_request'",
      "toReplacement": "false && always() && github.event_name != 'pull_request'",
      "expectedMatches": 2,
      "reason": "Docker Check Manifest and Clear steps: the manifest check reads an image that is never pushed; upstream guard kept, 'false &&' in front",
      "blocksFullParity": true
    },
    {
      "id": "secret-gate-docker-username",
      "kind": "secret-gate-annotation",
      "workflowFile": ".github/workflows/build-docker-images.yml",
      "jobId": "buildx",
      "fromPattern": "${{ secrets.DOCKER_USERNAME }}",
      "toReplacement": "",
      "expectedMatches": 1,
      "reason": "DOCKER_USERNAME does not exist in the benchmark org; only the Docker Login step reads it, and no-registry-login-or-push turns that step off. The reference is removed so no configuration reads it.",
      "blocksFullParity": false
    },
    {
      "id": "secret-gate-docker-password",
      "kind": "secret-gate-annotation",
      "workflowFile": ".github/workflows/build-docker-images.yml",
